# Shared NAS data root.
# Local: C:/NAS-Local/nas-data     NAS container: /app/data
DATA_ROOT=C:/NAS-Local/nas-data

# Report-only by default. Empty-folder removal needs ALL of:
# CLEANER_MODE=production, DRY_RUN=false, DESTRUCTIVE_ACTIONS_ENABLED=true,
# ALLOW_EMPTY_FOLDER_REMOVAL=true. See README.md.
CLEANER_MODE=development
DRY_RUN=true
DESTRUCTIVE_ACTIONS_ENABLED=false

# Timing: weekly automatic plan (when AUTO_RUN=true), 30-day age gate.
# Removals go through a recoverable trash hold (TRASH_HOLD_DAYS, below).
AUTO_RUN=false
CHECK_INTERVAL_SECONDS=604800
MIN_AGE_DAYS=30

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8092

# Optional overrides. Defaults are derived from DATA_ROOT.
# CLEANER_REPORTS_DIR=C:/NAS-Local/nas-data/_REPORTS/cleaner
# LEFTOVER_REVIEW_DIR=C:/NAS-Local/nas-data/_INGEST/leftover-review
# QUARANTINE_DIR=C:/NAS-Local/nas-data/_QUARANTINE

ALLOW_EMPTY_FOLDER_REMOVAL=false

# The trash hold. Each switch also needs the production gates above. Nothing is deleted when
# an item moves into the hold: it is renamed into _TRASH/<run>/ and can be restored. Only a
# purge deletes, and only after the hold has expired.
ALLOW_TRASH_HOLD=false          # move verified duplicates and ticked strays into the hold
ALLOW_QUARANTINE_DISCARD=false  # also take quarantine items you approved for discard in AA
ALLOW_KNOWN_TRASH_DELETE=false  # also take folders holding only CD-rip logs and known junk
ALLOW_TRASH_PURGE=false         # allow permanently deleting items whose hold has expired
TRASH_HOLD_DAYS=14
# TRASH_DIR=C:/NAS-Local/nas-data/_TRASH   (must be on the same disk as the data root)

IGNORE_INCOMING=true
IGNORE_PROCESSING=true

# Pages on other sites cannot make the dashboard write a plan or remove anything.
# Loopback addresses are always allowed. To open the dashboard from a phone or another
# PC, list its exact address here, comma separated (for example http://192.168.1.50:8092).
# ALLOWED_ORIGINS=
